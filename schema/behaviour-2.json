    {"kind": "commit", "class": "juristic, unilateral", "force": "commissive", "effects": ["commitment"], "reads": ["id", "to", "matter", "unit", "amount", "due"]},
    {"kind": "grant", "class": "juristic, unilateral", "force": "commissive", "effects": ["grant"], "reads": ["id", "to", "resource", "ceiling"]},
