    {"effect": "commitment", "changes": "commitments: create, move", "by law": ["lapse", "overdue"]},
    {"effect": "grant", "changes": "grants, and allowances charged along chains", "by law": []},
    {"effect": "holding", "changes": "holdings and their accesses; the check of a deposit", "by law": ["loan returns"]},
    {"effect": "claim", "changes": "claims: open, answer", "by law": []},
    {"effect": "assessment", "changes": "assessments: record", "by law": []},
    {"effect": "proposal", "changes": "proposals and the rules in force: ballots, adoption, a change applied", "by law": []},
    {"effect": "evidence", "changes": "nothing beyond the seal", "by law": []},
    {"effect": "party", "changes": "known parties with their control and provision: declare", "by law": []},
    {"effect": "recognition", "changes": "recognitions of other communities: set", "by law": []},
    {"effect": "agreement", "changes": "disclosure agreements: ratify, denounce; their records kept, returned or erased", "by law": ["agreement ends"]}
