    {"practice": "act through an agent", "slots": [{"role": "reasoning", "level": "E", "optional": true}, {"role": "operation", "level": "O"}, {"role": "trace", "level": "M"}, {"role": "act", "level": "N"}], "links": [{"bridge": "enactment", "from": "reasoning", "to": "operation"}, {"bridge": "manifestation", "from": "operation", "to": "trace"}, {"bridge": "codified counts-as", "from": "operation", "to": "act"}]},
    {"practice": "review", "slots": [{"role": "deliberation", "level": "E", "optional": true}, {"role": "reading", "level": "O"}, {"role": "assessment", "level": "M"}, {"role": "standing", "level": "S", "optional": true}, {"role": "finding", "level": "N"}], "links": [{"bridge": "enactment", "from": "deliberation", "to": "reading"}, {"bridge": "manifestation", "from": "reading", "to": "assessment"}, {"bridge": "social attribution", "from": "assessment", "to": "standing"}, {"bridge": "recognition by evidence", "from": "assessment", "to": "finding"}]}
