    {"kind": "amend", "class": "juristic, collective", "force": "declarative", "effects": ["proposal"], "reads": ["id"]},
    {"kind": "consult", "class": "juristic, unilateral", "force": "declarative", "effects": ["holding"], "reads": ["holding", "amount", "purpose", "transmit", "kind", "within", "digest", "source", "licence", "unit", "to", "until"]},
    {"kind": "deposit", "class": "juristic, unilateral", "force": "declarative", "effects": ["holding"], "reads": ["holding", "amount", "purpose", "transmit", "kind", "within", "digest", "source", "licence", "unit", "to", "until"]},
    {"kind": "modify", "class": "juristic, unilateral", "force": "declarative", "effects": ["holding"], "reads": ["holding", "amount", "purpose", "transmit", "kind", "within", "digest", "source", "licence", "unit", "to", "until"]},
