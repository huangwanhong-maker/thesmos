    {"name": "tokens", "space": "real", "unit": "tokens", "scale": 100000, "recorded by": "the principal's ledger", "grade": "A"},
    {"name": "runs", "space": "real", "unit": "runs", "scale": 10, "recorded by": "the node", "grade": "A"},
    {"name": "seconds", "space": "real", "unit": "seconds", "scale": 3600, "recorded by": "the node", "grade": "A"},
    {"name": "bytes", "space": "real", "unit": "bytes", "scale": 1000000, "recorded by": "the node", "grade": "A"},
    {"name": "inputs", "space": "digests", "unit": "SHA-256", "recorded by": "the node", "grade": "A"},
    {"name": "outputs", "space": "digests", "unit": "SHA-256", "recorded by": "the node", "grade": "A"},
    {"name": "holdings touched", "space": "set", "recorded by": "the gateway", "grade": "A"},
    {"name": "items touched", "space": "set", "recorded by": "the gateway", "grade": "A"},
    {"name": "provider", "space": "categorical", "recorded by": "the passport", "grade": "A"},
    {"name": "model", "space": "categorical", "recorded by": "the passport", "grade": "A"},
    {"name": "community", "space": "categorical", "recorded by": "the gateway", "grade": "A"},
    {"name": "node", "space": "categorical", "recorded by": "the gateway", "grade": "A"},
    {"name": "words", "space": "real", "unit": "words", "scale": 1000, "recorded by": "analysis", "grade": "C"},
    {"name": "epistemic kind", "space": "categorical", "vocabulary": ["reasoning", "plan", "deliberation", "model call"], "recorded by": "the agent's disclosure", "grade": "C", "level": "E"},
    {"name": "disclosed under", "space": "categorical", "recorded by": "the disclosure agreement", "grade": "A", "level": "E"}
  ],
  "nearness": "sum",
  "conduct": [
    {"category": "bench run", "where": "operation is 'run tool' and holdings-touched contains 'bench'"},
    {"category": "heavy model call", "where": "operation is 'call model' and tokens above 100000"},
    {"category": "a reading", "where": "operation is 'read'"}
  ],
  "counts as": [],
  "triggers": [
    {"rule": "a loan returns at its term", "then": "loan returns", "by the ground": true},
    {"rule": "a commitment past its due is overdue", "then": "overdue", "by the ground": true},
    {"rule": "a disclosure agreement ends at its term or its notice", "then": "agreement ends", "by the ground": true}
  ],
  "recognition": [
    {"fact": "authorship", "grade at least": "B", "attested by": "another origin"}
  ],
  "levels": [
    {"level": "E", "name": "epistemic behaviour", "register": "Ontological"},
    {"level": "O", "name": "ontological conduct", "register": "Ontological"},
    {"level": "M", "name": "manifest conduct", "register": "Manifestational"},
    {"level": "S", "name": "social conduct", "register": "Relational", "indexed by": "structure"},
    {"level": "N", "name": "normative conduct", "register": "Relational", "indexed by": "order", "forms": ["constituted act", "qualified conduct"]}
  ],
  "facets": [
    {"facet": "stage", "ordered": true, "values": ["formation of intent", "preparation", "commencement", "execution", "completion"], "levels": ["E", "O", "S", "N"]},
