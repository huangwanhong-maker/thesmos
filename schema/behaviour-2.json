    {"facet": "modality", "values": ["communicative", "physical", "computational"], "levels": ["O", "M", "S", "N"]},
    {"facet": "intention", "ordered": true, "values": ["accidental", "negligent", "foreseen", "intended"], "levels": ["E", "S", "N"]},
    {"facet": "scope", "values": ["self-regarding", "other-regarding", "directed at a structure"], "levels": ["E", "O", "S", "N"]}
  ],
  "bridges": [
