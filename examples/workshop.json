{
  "format": "noetarium.constitution/1",
  "name": "workshop",
  "purpose": "An invented commons that checks a catalogue against its sources; contributors, persons or operatives, vote with the stewards and reviewers, counted by origin.",
  "positions": {
    "steward": {"held by": ["person"]},
    "reviewer": {"held by": ["person"]},
    "contributor": {"held by": ["person", "organisation", "operative"]},
    "member": {"held by": ["person", "organisation"]}
  },
  "boundary": {
    "contributor": {"entry": "open", "exit": "free"},
    "reviewer": {"entry": {"decided by": "admit"}, "exit": "free"},
    "member": {"entry": {"decided by": "admit"}, "exit": "free"},
    "steward": {"entry": {"decided by": "appoint steward"}, "exit": {"notice": "one round"}}
  },
  "choice": [
    {"who": "anyone", "may": ["say", "acknowledge", "claim"]},
    {"who": "contributor", "may": ["offer", "commit", "deliver", "hand over", "report", "propose", "vote"], "in": ["tasks", "assembly"]},
    {"who": "member", "may": ["propose", "vote"], "in": ["assembly"]},
    {"who": "reviewer", "may": ["assess", "propose", "vote", "attest"], "in": ["review", "assembly"]},
    {"who": "steward", "may": ["admit", "request", "take", "accept", "release", "grant", "convert", "propose", "vote", "amend", "assess", "report", "attest", "deploy"]},
    {"who": "steward", "must": ["answer"], "when": "a claim is admitted", "within": "one round"}
  ],
  "bodies": {
    "stewards": {"of": ["steward"]},
    "assembly": {"of": ["steward", "reviewer", "contributor", "member"]}
  },
  "aggregation": {
    "admit": {"body": "stewards", "rule": "any one", "count by": "person", "tempo": "operative"},
    "answer claim": {"body": "stewards", "rule": "any one", "count by": "person", "tempo": "deliberative"},
    "appoint steward": {"body": "assembly", "rule": "majority", "count by": "origin", "tempo": "deliberative"},
    "amend operational": {"body": "assembly", "rule": "majority", "count by": "origin", "tempo": "deliberative"},
    "amend constitutional": {"body": "assembly", "rule": "two thirds", "count by": "origin", "tempo": "constitutional"}
  },
  "scenes": {
    "tasks": {"acts": ["request", "offer", "take", "deliver", "hand over", "accept", "release"], "read": "anyone", "write": ["contributor", "steward"], "presence": "mixed", "tempo": "operative"},
    "review": {"acts": ["assess", "say"], "read": ["steward", "reviewer"], "write": ["steward", "reviewer"], "presence": "persons", "tempo": "deliberative"},
    "assembly": {"acts": ["propose", "vote", "amend"], "read": "anyone", "write": ["steward", "reviewer", "contributor", "member"], "presence": "mixed", "tempo": "deliberative"},
    "intake": {"acts": ["claim", "answer"], "read": ["steward"], "write": "anyone", "presence": "persons", "tempo": "deliberative"}
  },
  "payoff": {"returns": {"basis": "acknowledgement"}, "sanctions": ["note", "suspension"]},
  "scope": {"governs": ["the work declared in its tasks"], "leaves": ["conditions of use set by a source"]},
  "conversions": {},
  "receiving": {"unit": "hours of review", "per round": 6},
  "circulation": ["gift", "common provision"],
  "claims": {"route": "stewards", "decided by": "answer claim", "outsiders": true, "review": "assembly"},
  "custody": {
    "powers": {"deploy": ["steward"]},
    "keys": {"threshold": 1, "of": ["steward"]},
    "reserve": []
  },
  "preserved": ["a contributor can raise a challenge to a criterion and reach a role that may revise it"],
  "amendment": {
    "operational": "amend operational",
    "collective choice": "amend constitutional",
    "constitutional": "amend constitutional",
    "entrenched": ["claims", "exit with the record"]
  },
  "records": {"captured": ["acts of force"], "talk": "by the scene's rule", "retention": "five years", "visibility": {"custody": {"office": ["steward"]}, "holders": "members"}},
  "external": {"card": true, "envoys": [], "compacts": []},
  "holdings": {
    "sources": {"kind": "data", "custodian": "steward", "review": "another origin", "visibility": "public", "provenance": {"source": "the workshop's founding", "licence": "CC BY 4.0"}},
    "catalogue": {"kind": "document", "custodian": "steward", "visibility": "public", "provenance": {"digest": "da8576f17750fce3999ab0a09acb216fe8b6e8a3ea58acc483f74344deb46773", "source": "the workshop catalogue, first edition", "licence": "CC BY 4.0"}},
    "review hours": {"kind": "capacity", "unit": "hours", "quantity": 40, "custodian": "steward"},
    "tokens": {"kind": "budget", "unit": "tokens", "quantity": 200000, "custodian": "steward"},
    "relief": {"kind": "budget", "unit": "hours", "quantity": 10, "custodian": "steward"},
    "guide": {"kind": "knowledge", "custodian": "steward", "visibility": "public", "provenance": {"source": "an invented guide to the workshop", "licence": "CC BY 4.0"}},
    "accounts": {"kind": "reference", "custodian": "steward", "visibility": {"office": "steward"}, "provenance": {"source": "the workshop's account, kept elsewhere"}}
  },
  "access": {
    "open": {"knowledge": ["consult"]},
    "norms": [
      {"id": "sources consulted", "who": "any position", "may": "consult", "object": "sources", "transmit": "any"},
      {"id": "sources deposited", "who": "contributor", "may": "deposit", "object": "sources"},
      {"id": "sources withdrawn", "who": {"role": "custodian"}, "may": "withdraw", "object": "sources"},
      {"id": "a source corrected", "who": {"role": "depositor"}, "may": "modify", "object": "sources"},
      {"id": "catalogue consulted", "who": "anyone", "may": "consult", "object": "catalogue"},
      {"id": "catalogue revised", "who": "steward", "may": "modify", "object": "catalogue"},
      {"id": "review hours used", "who": "reviewer", "may": "use", "object": "review hours", "quota": 6, "for": ["review"], "or else": "the hours are not given"},
      {"id": "review hours lent", "who": {"role": "custodian"}, "may": "lend", "object": "review hours"},
      {"id": "tokens drawn by agents", "who": {"kind": "operative"}, "may": "use", "object": "tokens", "quota": 50000, "under mandate": {"kinds": ["use"], "matters": ["catalogue"]}},
      {"id": "relief by need", "who": "any position", "may": "use", "object": "relief", "quota": 2, "need": "pressing need"},
      {"id": "catalogue kept current", "who": "steward", "must": "modify", "object": "catalogue", "or else": "the catalogue falls behind its sources"}
    ]
  }
}
